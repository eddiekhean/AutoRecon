								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"old_password\": \"Auto5c@Start123\",\n    \"new_password\": \"NewSecretPass@999\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/users/me/password",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
