# SQL Server Database Config
DB_HOST=localhost
# SA is the built-in system administrator; use a dedicated app account in production.
DB_USER=sa
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD   # Must meet SQL Server complexity: upper+lower+digit+symbol, min 8 chars
DB_NAME=autorecon
DB_PORT=1433                            # SQL Server default port
# Encryption: "disable" for local dev (Docker with no TLS); "true" for production.
DB_ENCRYPT=disable
# Trust self-signed certificates: "true" for local dev; "false" when using a CA-signed cert in prod.
DB_TRUST_SERVER_CERT=true

# Application Settings
PORT=8080

# RSA key pair — generate with:
#   openssl genrsa -out keys/private.pem 2048
#   openssl rsa -in keys/private.pem -pubout -out keys/public.pem
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem

# Comma-separated list of allowed CORS origins (no trailing slash)
# Example: http://localhost:5173,https://app.yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:5173

# First-run admin bootstrap (used only when users table is empty)
ADMIN_DEFAULT_EMAIL=admin@example.com
ADMIN_DEFAULT_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Token TTL (Go duration format: 15m, 1h, 168h, etc.)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# HMAC key for hashing refresh tokens before DB storage (never store raw UUIDs).
# Generate: openssl rand -hex 32
REFRESH_TOKEN_HMAC_KEY=CHANGE_ME_RANDOM_32_BYTE_HEX
