# PostgreSQL Database Config
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_NAME=autorecon
DB_PORT=5432
# For production set to "require" or "verify-full". Use "disable" only for local dev.
DB_SSL_MODE=disable

# Redis Cache Config
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Application Settings
PORT=8080

# RSA key pair — generate with:
#   openssl genrsa -out keys/private.pem 2048
#   openssl rsa -in keys/private.pem -pubout -out keys/public.pem
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem

# Comma-separated list of allowed CORS origins (no trailing slash)
# Example: http://localhost:5173,https://app.yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:5173

# First-run admin bootstrap (used only when users table is empty)
ADMIN_DEFAULT_EMAIL=admin@example.com
ADMIN_DEFAULT_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Token TTL (Go duration format: 15m, 1h, 168h, etc.)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
